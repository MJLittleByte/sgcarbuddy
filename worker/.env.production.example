# PRODUCTION keys for the SG Car Buddy Worker (the Play Store release).
#
#   cp .env.production.example .env.production     (gitignored: never commit the filled-in file)
#   npm run deploy:prod                            (deploys sgcarbuddy-api and uploads these as Cloudflare secrets)
#
# Register keys for THIS app (not SG BusXing's). Only non-empty values are uploaded. Nothing here ever goes into the
# app: the APK only knows the public Worker URL (mobile/.env.production).

# REQUIRED: LTA DataMall AccountKey, purpose "Mobile APP".
# https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# RECOMMENDED: data.gov.sg API key (production tier). https://data.gov.sg → Dashboard → API keys
DATAGOVSG_API_KEY=

# OPTIONAL: OneMap account for place / postal-code search. https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# OPTIONAL: URA Data Service AccessKey (exact URA carpark rates). https://eservice.ura.gov.sg/maps/api/
URA_ACCESS_KEY=
