{
  "name": "sgcarbuddy-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 0.0.0.0",
    "dev:node": "tsx scripts/dev-node.ts",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "usage": "node scripts/usage.mjs",
    "catalog": "tsx scripts/build-catalog.ts",
    "deploy:prod": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "tsx": "^4.23.15",
    "@types/node": "^24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
