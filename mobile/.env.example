# Copy to `.env.local` (gitignored).
#
# URL of the SG Car Buddy Worker (../worker). This is PUBLIC — it ships inside the app.
# NEVER put any API key here: every VITE_* value is bundled into the APK.
#
#   empty                              -> demo mode (bundled carparks with sample lots, sample EV and roads; live NEA weather and LTA cameras)
#   http://localhost:8787              -> `npm run dev:node` in ../worker, browser testing
#   http://10.0.2.2:8787               -> same, from the Android emulator (build with CAP_DEV_HTTP=1)
#   https://sgcarbuddy-api.<you>.workers.dev -> deployed Worker (phones, release builds)
VITE_API_BASE_URL=

# Mock ads (bottom banner on the main tabs + one in-feed ad in Roads) until AdMob is added. `off` hides them.
VITE_AD_PLACEHOLDER=
