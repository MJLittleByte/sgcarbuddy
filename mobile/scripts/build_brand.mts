/**
 * Generates every logo asset from src/brand/mark.ts:
 *   public/favicon.svg, public/brand/icon-tile.svg + icon-round.svg (sources for the legacy PNGs and the Play icon),
 *   Android ic_brand_foreground.xml / ic_brand_monochrome.xml / ic_launcher_bg.xml (adaptive icon),
 *   and the boot (loading) screen block in index.html.
 * Run: npm run brand   (then render the legacy launcher PNGs and Play icon: see mobile/README.md → Brand)
 */
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { BRAND, MARK_SCALE, MARK_VIEWBOX, P, PIN, SHADE, markSvg } from '../src/brand/mark.ts';

/** The one line under the name on the loading screen. */
export const TAGLINE = 'Park. Charge. Go.';
/** Plain-English line under the tagline. */
export const SUBLINE = 'Live carparks, EV chargers, checkpoint cameras and rain.';

const root = new URL('..', import.meta.url);
const out = (rel: string, text: string) => {
  const url = new URL(rel, root);
  mkdirSync(new URL('.', url), { recursive: true });
  writeFileSync(url, text);
  console.log('wrote', rel);
};

/* ---------- SVG tiles (favicon, legacy PNG + Play icon sources) ---------- */
const scaled = (inner: string) => `<g transform="translate(54 54) scale(${MARK_SCALE}) translate(-54 -54.25)">${inner}</g>`;
const gradient = `<linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${BRAND.blueTop}"/><stop offset="1" stop-color="${BRAND.blueBottom}"/></linearGradient>`;
const tile = (shape: 'square' | 'round') =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="18 18 72 72"><defs>${gradient}<clipPath id="c">${
    shape === 'round' ? '<circle cx="54" cy="54" r="36"/>' : '<rect x="18" y="18" width="72" height="72" rx="17"/>'
  }</clipPath></defs><g clip-path="url(#c)"><rect width="108" height="108" fill="url(#bg)"/>${scaled(markSvg(BRAND.blue))}</g></svg>\n`;
out('public/favicon.svg', tile('square'));
out('public/brand/icon-tile.svg', tile('square'));
out('public/brand/icon-round.svg', tile('round'));

/* ---------- Android adaptive icon ---------- */
const vector = (comment: string, body: string) => `<?xml version="1.0" encoding="utf-8"?>
<!-- ${comment} Generated by scripts/build_brand.mts from src/brand/mark.ts: edit there. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:pivotX="54" android:pivotY="54" android:scaleX="${MARK_SCALE}" android:scaleY="${MARK_SCALE}" android:translateY="-0.25">
${body}    </group>
</vector>
`;
const p = (d: string, attrs: string) => `        <path android:pathData="${d}" ${attrs} />\n`;

out(
  'android/app/src/main/res/drawable/ic_brand_foreground.xml',
  vector(
    'SG Car Buddy mark: white pin with a blue P.',
    p(PIN, `android:fillColor="${BRAND.white}"`) + p(SHADE, `android:fillColor="${BRAND.shade}"`) + p(P, `android:fillColor="${BRAND.blue}" android:fillType="evenOdd"`),
  ),
);
// Themed (Material You) icon: one colour; the P is cut out of the pin (evenOdd: pin ⊃ P ⊃ counter).
out('android/app/src/main/res/drawable/ic_brand_monochrome.xml', vector('Themed (Material You) icon: single colour, tinted by the launcher.', p(`${PIN} ${P}`, 'android:fillColor="#FFFFFF" android:fillType="evenOdd"')));
// Gradient tile behind the adaptive icon (Android angle 315 = top-left → bottom-right).
out(
  'android/app/src/main/res/drawable/ic_launcher_bg.xml',
  `<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background (brand blue gradient). Generated by scripts/build_brand.mts. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="${BRAND.blueTop}" android:endColor="${BRAND.blueBottom}" android:type="linear" />
</shape>
`,
);
for (const name of ['ic_launcher', 'ic_launcher_round']) {
  out(
    `android/app/src/main/res/mipmap-anydpi-v26/${name}.xml`,
    `<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_brand_foreground" />
    <monochrome android:drawable="@drawable/ic_brand_monochrome" />
</adaptive-icon>
`,
  );
}

/* ---------- Boot (loading) screen in index.html ---------- */
const boot = `<!-- boot:start — loading screen, generated by scripts/build_brand.mts (npm run brand). Hidden by src/app/boot.ts. -->
    <style>
      #boot { position: fixed; inset: 0; z-index: 1000; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px;
        background: linear-gradient(160deg, ${BRAND.blueTop} 0%, ${BRAND.blue} 55%, ${BRAND.blueBottom} 100%); color: #fff; text-align: center;
        font-family: 'Figtree Variable', system-ui, sans-serif; transition: opacity 0.35s ease; }
      #boot.boot-out { opacity: 0; pointer-events: none; }
      #boot svg { width: 112px; height: 112px; overflow: visible; filter: drop-shadow(0 10px 18px rgba(4, 18, 60, 0.35)); animation: boot-drop 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.2) both; }
      #boot .boot-name { margin: 22px 0 0; font-size: 34px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; animation: boot-up 0.5s 0.2s ease-out both; }
      #boot .boot-tag { margin: 12px 0 0; font-size: 18px; font-weight: 700; animation: boot-up 0.5s 0.3s ease-out both; }
      #boot .boot-sub { margin: 6px 0 0; font-size: 14px; font-weight: 500; opacity: 0.82; animation: boot-up 0.5s 0.4s ease-out both; }
      #boot .boot-dots { position: absolute; left: 0; right: 0; bottom: calc(56px + env(safe-area-inset-bottom, 0px)); display: flex; justify-content: center; gap: 8px; }
      #boot .boot-dots i { width: 7px; height: 7px; border-radius: 50%; background: #fff; opacity: 0.35; animation: boot-dot 1.1s ease-in-out infinite; }
      #boot .boot-dots i:nth-child(2) { animation-delay: 0.15s; }
      #boot .boot-dots i:nth-child(3) { animation-delay: 0.3s; }
      @keyframes boot-drop { from { transform: translateY(-18px) scale(0.85); opacity: 0; } }
      @keyframes boot-up { from { transform: translateY(10px); opacity: 0; } }
      @keyframes boot-dot { 50% { opacity: 1; transform: translateY(-3px); } }
      @media (prefers-reduced-motion: reduce) { #boot, #boot * { animation: none !important; transition: none !important; } }
    </style>
    <div id="boot" role="status" aria-label="Loading SG Car Buddy">
      <svg viewBox="${MARK_VIEWBOX}" aria-hidden="true">${markSvg(BRAND.blue)}</svg>
      <p class="boot-name">SG Car Buddy</p>
      <p class="boot-tag">${TAGLINE}</p>
      <p class="boot-sub">${SUBLINE}</p>
      <span class="boot-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <script>setTimeout(function () { var b = document.getElementById('boot'); if (b) b.remove(); }, 10000);</script>
    <!-- boot:end -->`;
const htmlUrl = new URL('index.html', root);
let html = readFileSync(htmlUrl, 'utf8');
html = /<!-- boot:start[\s\S]*?<!-- boot:end -->/.test(html)
  ? html.replace(/<!-- boot:start[\s\S]*?<!-- boot:end -->/, boot)
  : html.replace('<body>', `<body>\n    ${boot}`);
writeFileSync(htmlUrl, html);
console.log('wrote index.html boot screen');
