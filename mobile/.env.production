# Production build settings (npm run build / android:apk / android:aab). Public values only: everything here ships
# inside the app. Rewritten by `cd ../worker && npm run deploy:prod` with the URL Cloudflare actually assigns;
# `npm run release:check` verifies it is live before a Play bundle is built. Local dev keeps using mobile/.env.local.
VITE_API_BASE_URL=https://sgcarbuddy-api.mjlittlebyte.workers.dev
# No placeholder ads in release builds (AdMob is not added yet).
VITE_AD_PLACEHOLDER=off
