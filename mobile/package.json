{
  "name": "sgcarbuddy-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "npm run cap:sync && cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "android:apk": "npm run cap:sync && bash scripts/gradle.sh assembleDebug",
    "brand": "node scripts/build_brand.mts && node scripts/render_icons.mjs",
    "android:keystore": "bash scripts/create-keystore.sh",
    "release:check": "node scripts/check-release.mjs",
    "android:aab": "npm run release:check && npm run cap:sync && bash scripts/gradle.sh bundleRelease && echo \"\\nAAB: mobile/android/app/build/outputs/bundle/release/app-release.aab\"",
    "store:graphic": "node scripts/store_assets.mjs --graphic",
    "store:screens": "node scripts/store_assets.mjs --screens",
    "store:frame": "node scripts/store_assets.mjs --frame"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "androidVersionCode": 1
}
